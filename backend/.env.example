# Play2Build backend config. Copy this file to `.env` and fill in your keys.

# --- The brain (DeepSeek) ---
# Create an API key at https://platform.deepseek.com (API keys -> create)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# DeepSeek pricing (USD per 1M tokens, official 2026) — used for cost tracking
DEEPSEEK_IN_RATE=0.14
DEEPSEEK_OUT_RATE=0.28

# --- Your GitHub ---
# Create a token at https://github.com/settings/tokens
# Classic token, scope: "repo" (covers creating + pushing public repos)
GITHUB_TOKEN=
# 1 = repos are public, 0 = private
GITHUB_PUBLIC=1
# Repos get named like: play2build-snake-game-1a2b
REPO_PREFIX=play2build

# --- The factory ---
# This must match the SECRET in the Roblox game (game/src/shared/Config.lua)
P2B_SECRET=dev-secret-change-me
P2B_PORT=8000
P2B_MAX_WORKERS=4

# --- Testing only ---
# ENGINE=mock builds a hello-world repo with no AI (no DeepSeek key needed)
ENGINE=deepseek
